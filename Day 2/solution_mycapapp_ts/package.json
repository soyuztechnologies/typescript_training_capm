{
  "name": "mycapapp",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@sap/cds": "^9",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.1",
    "@cap-js/cds-typer": "^0.39.1",
    "@cap-js/cds-types": "^0.15.0",
    "@cap-js/sqlite": "^2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "jest": "^29",
    "ts-jest": "^29.4.11",
    "tsx": "^4",
    "typescript": "^5"
  },
  "scripts": {
    "start": "cds-serve",
    "test": "jest --forceExit"
  },
  "cds": {
    "server": {
      "shutdown_on_uncaught_errors": false
    },
    "requires": {
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "alice": {
              "password": "anubhav",
              "roles": [
                "Display", "Edit"
              ]
            },
            "bob": {
              "password": "ananya",
              "roles": [
                "Display", "Edit"
              ]
            }
          }
        },
        "[production]": {
          "kind": "xsuaa"
        }
      }
    }
  },
  "private": true,
  "sapux": [
    "app/managepo"
  ],
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  }
}
